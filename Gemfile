source "https://rubygems.org"

# Jekyll 3.10 is the version GitHub Pages runs, so local preview matches the
# live site. Bumped from the theme's 3.8.5 to work on modern Ruby.
gem "jekyll", "~> 3.10.0"

gem "webrick", "~> 1.8"

# GitHub-flavored markdown parser (bundled on GitHub Pages, explicit here).
gem "kramdown-parser-gfm"

# Gems that left Ruby's stdlib and must now be declared explicitly.
gem "rexml"
gem "csv"
gem "base64"
gem "bigdecimal"
